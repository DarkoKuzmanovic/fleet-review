{
  "name": "fleet-review",
  "displayName": "Fleet Review",
  "description": "Multi-AI code review for GitHub PRs with model scoring",
  "version": "0.1.0",
  "publisher": "darko-kuzmanovic",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fleetReview.startReview",
        "title": "Start Code Review",
        "category": "Fleet Review"
      },
      {
        "command": "fleetReview.gradeReview",
        "title": "Grade Models",
        "category": "Fleet Review"
      },
      {
        "command": "fleetReview.gradeWithClaude",
        "title": "Grade with Claude Code",
        "category": "Fleet Review"
      },
      {
        "command": "fleetReview.viewScores",
        "title": "Show Leaderboard",
        "category": "Fleet Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fleetReview",
          "title": "Fleet Review",
          "icon": "$(preview)"
        }
      ]
    },
    "views": {
      "fleetReview": [
        {
          "type": "webview",
          "id": "fleetReview.sidebar",
          "name": "Fleet Review"
        }
      ]
    },
    "configuration": {
      "title": "Fleet Review",
      "properties": {
        "fleetReview.defaultModels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "gemini",
              "qwen",
              "copilot",
              "glm"
            ]
          },
          "default": [
            "claude",
            "gemini",
            "qwen"
          ],
          "description": "Default AI models to use for code review"
        },
        "fleetReview.dataDir": {
          "type": "string",
          "default": "~/.config/fleet-review",
          "description": "Directory for review data and scores"
        },
        "fleetReview.geminiModel": {
          "type": "string",
          "enum": [
            "auto",
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "gemini-3-flash-preview",
            "gemini-3.1-pro-preview"
          ],
          "default": "auto",
          "description": "Gemini model for code review. 'auto' lets Gemini CLI pick the best model (Gemini 3)."
        },
        "fleetReview.nanoGptApiKey": {
          "type": "string",
          "default": "",
          "description": "Nano-GPT API key for GLM model reviews. Get one at nano-gpt.com. Falls back to NANO_GPT_API_KEY env var."
        },
        "fleetReview.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Timeout in seconds for each model's review"
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
